# Provider de IA ativo: "google" (Gemini, validado) ou "ollama" (local, best-effort)
PROVIDER=google

# Banco (Postgres + pgVector)
# POSTGRES_PORT: porta do host (docker-compose lê daqui; fallback 5432).
# Usa 2432 (e não 5432) para não colidir com outros Postgres locais.
POSTGRES_PORT=2432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:2432/rag
PG_VECTOR_COLLECTION_NAME=docs

# PDF a ser ingerido
PDF_PATH=document.pdf

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.2

# --- Google (Gemini) ---
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_LLM_MODEL=gemini-2.5-flash-lite
